# API / control plane
RUNQ_DATABASE_URL=postgres://runq:runq@localhost:5432/runq?sslmode=disable
RUNQ_API_ADDR=:8080
RUNQ_API_TOKENS=admin-token:admin,tenant-token:tenant:tenant-api,worker-token:worker:worker-api
RUNQ_API_METRICS_ADDR=127.0.0.1:9090
RUNQ_TRACE_OTLP_ENDPOINT=http://localhost:4318/v1/traces
RUNQ_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
RUNQ_LEASE_DURATION_SECONDS=30

# scheduler / reaper shared settings
RUNQ_TICK_INTERVAL_SECONDS=5
RUNQ_CLAIM_BATCH_SIZE=10
RUNQ_TENANT_MAX_INFLIGHT=0
RUNQ_SCHEDULER_METRICS_ADDR=127.0.0.1:9091
RUNQ_REAPER_METRICS_ADDR=127.0.0.1:9092

# worker settings
RUNQ_API_BASE_URL=http://localhost:8080
RUNQ_WORKER_AUTH_TOKEN=worker-token
RUNQ_WORKER_NAME=worker-api
RUNQ_WORKER_QUEUES=default
RUNQ_WORKER_CAPABILITIES=http
RUNQ_WORKER_MAX_CONCURRENCY=4
RUNQ_WORKER_POLL_INTERVAL_SECONDS=2
RUNQ_WORKER_EXECUTION_SECONDS=3
RUNQ_WORKER_METRICS_ADDR=127.0.0.1:9093

# migration settings
RUNQ_MIGRATIONS_DIR=migrations
